# Local secrets. NOT committed — see .gitignore.
# Providers are tried in order; the next one takes over when a provider is
# rate-limited, out of quota, or erroring. Add a _3 block to extend the chain.

LLM_PROVIDER_1_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_PROVIDER_1_API_KEY=nvapi-your-primary-key-here
LLM_PROVIDER_1_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_PROVIDER_1_THINKING=false

LLM_PROVIDER_2_MODEL=openai/gpt-oss-20b
LLM_PROVIDER_2_API_KEY=nvapi-your-fallback-key-here
LLM_PROVIDER_2_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_PROVIDER_2_THINKING=false

# --- Local development -------------------------------------------------
# The defaults are sized for a shared public instance. On your own machine
# you are the only user, so the abuse limits just get in your way.
RATE_LIMIT_COMPILES=200
RATE_LIMIT_EXTRACTIONS=100

# MiKTeX downloads missing packages during the first few compiles, which can
# take well over the default 20s. Drop this back once the cache is warm.
COMPILE_TIMEOUT=120
